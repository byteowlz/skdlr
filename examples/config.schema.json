{
  "$id": "https://github.com/byteowlz/skdlr/schemas/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skdlr configuration",
  "description": "Configuration schema for skdlr",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for editor support",
      "type": "string"
    },
    "api": {
      "description": "HTTP API server configuration.",
      "allOf": [
        {
          "$ref": "#/definitions/ApiConfig"
        }
      ],
      "default": {
        "allowed_origins": [
          "http://localhost:3000"
        ]
      }
    },
    "backend": {
      "description": "Backend to use (auto-detected if not set).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "default_workdir": {
      "description": "Default working directory for schedules.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "executor": {
      "description": "Executor wrapper configuration.",
      "allOf": [
        {
          "$ref": "#/definitions/ExecutorConfig"
        }
      ],
      "default": {
        "wrapper": null,
        "wrapper_args": []
      }
    },
    "internal": {
      "description": "Internal backend configuration.",
      "allOf": [
        {
          "$ref": "#/definitions/InternalConfig"
        }
      ],
      "default": {
        "check_interval_secs": 60
      }
    },
    "logging": {
      "description": "Logging configuration.",
      "allOf": [
        {
          "$ref": "#/definitions/LoggingConfig"
        }
      ],
      "default": {
        "file": null,
        "level": "info"
      }
    },
    "service_prefix": {
      "description": "Prefix for service/timer names.",
      "type": "string",
      "default": "skdlr"
    }
  },
  "stability": "accepted",
  "version": "0.3.0",
  "definitions": {
    "ApiConfig": {
      "description": "HTTP API server configuration.",
      "type": "object",
      "properties": {
        "allowed_origins": {
          "description": "Exact origins allowed to call the API (CORS). Never `*`.",
          "type": "array",
          "default": [
            "http://localhost:3000"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ExecutorConfig": {
      "description": "Executor wrapper configuration for running scheduled commands.",
      "type": "object",
      "properties": {
        "wrapper": {
          "description": "Wrapper binary to run all commands through (e.g., \"octo-sandbox\").",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "wrapper_args": {
          "description": "Arguments passed to wrapper before the scheduled command.\nSupports placeholders: {name}, {workdir}, {command}",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "InternalConfig": {
      "description": "Internal backend configuration.",
      "type": "object",
      "properties": {
        "check_interval_secs": {
          "description": "Check interval in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        }
      }
    },
    "LoggingConfig": {
      "description": "Logging configuration.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Optional log file path.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "level": {
          "description": "Log level (trace, debug, info, warn, error).",
          "type": "string",
          "default": "info"
        }
      }
    }
  }
}